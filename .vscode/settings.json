{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "automatic",
  "java.import.gradle.enabled": false,
  "editor.formatOnSave": true,
  "files.exclude": {
    "target": true,
    "data": true
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/data/**": true
  },
  "[java]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[jsp]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[xml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}
